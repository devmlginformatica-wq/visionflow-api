# ═══════════════════════════════════════════════════════════
# VisionFlow API — variáveis de ambiente
# Copie para .env e preencha com valores reais.
# .env NÃO é versionado (está no .gitignore).
# ═══════════════════════════════════════════════════════════

# ─── Servidor HTTP ───────────────────────────────────────────
PORT=8080
# Console SQL somente em desenvolvimento; exige APP_ENV=development e usuário admin.
APP_ENV=production
SQL_CONSOLE_ENABLED=false

# ─── PostgreSQL ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
# Para console SQL, DB_USER deve ser uma role sem SUPERUSER/BYPASSRLS e sem propriedade de tabelas RLS.
DB_USER=epare
DB_PASSWORD=trocar_pela_senha_real
DB_NAME=epare_forca_de_vendas
DB_SSLMODE=disable

# Pool (opcional — usa defaults se omitir)
DB_POOL_MAX_CONNS=10
DB_POOL_MIN_CONNS=2
DB_POOL_MAX_CONN_LIFETIME=30m

# ─── Relatórios com IA (opcional) ────────────────────────────
# A feature só é habilitada quando DB_IA_* e LLM_PROVIDER estão configurados.
# Use um papel PostgreSQL dedicado, sem SUPERUSER nem BYPASSRLS, com acesso somente de leitura.
DB_IA_HOST=localhost
DB_IA_PORT=5432
DB_IA_NAME=epare_forca_de_vendas
DB_IA_USER=visionflow_ia
DB_IA_PASSWORD=trocar_pela_senha_da_role_visionflow_ia
DB_IA_SSLMODE=disable

# Provedores: groq, openai, googleai, ollama, openrouter ou fake.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
# Opcional para groq/openrouter; Ollama usa http://localhost:11434 quando vazio.
LLM_BASE_URL=
LLM_API_KEY=trocar_pela_chave_do_provedor
LLM_TIMEOUT_SECONDS=30

# Use 0 para não adicionar LIMIT automaticamente.
RELATORIO_IA_LIMIT_DEFAULT=1000

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=trocar_por_uma_string_longa_e_aleatoria
JWT_EXPIRATION=8h


# ─── CORS ────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,https://humble-computing-machine-jq6pxpqwgpqfpj49-5173.app.github.dev

# ─── Ambiente / Console SQL (apenas desenvolvimento) ─────────
APP_ENV=development
SQL_CONSOLE_ENABLED=true